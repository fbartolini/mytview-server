# Copy to .env and adjust.

# ── docker compose ──────────────────────────────────────────────────────────────

# Host path bind-mounted READ-ONLY into the container at /media. REQUIRED.
# Must be a real local path or a mount point — NOT an nfs:// / smb:// URL (mount it first).
MEDIA_ROOT_HOST=/path/to/your/library

# Optional — only behind a reverse proxy / TLS. Use your real access URL:
# ORIGIN=https://mytview.example.com
# And the header carrying the real client IP, so login rate limits see clients:
# ADDRESS_HEADER=x-forwarded-for

# Who may create accounts: invite (default) | all | off. Login is always allowed.
ALLOW_SIGNUP=invite

# 1 = Intel VAAPI hardware encode for live HLS (needs the /dev/dri passthrough in
# docker-compose.yml); unset/0 = CPU (libx264). Falls back to CPU automatically.
# TRANSCODE_HWACCEL=1

# Host path for the live-HLS scratch dir (a named volume is used if unset).
# TRANSCODE_DIR_HOST=/path/to/scratch

# ── local dev only (npm run dev / node build) — IGNORED by docker compose ───────

# Where the app reads media on THIS machine.
MEDIA_ROOT=/path/to/your/library

# SQLite index location. Disposable; rebuilt from disk on scan.
DB_PATH=./index.db

# Where live-HLS session segments are written (default: an OS temp dir; `off` disables
# live transcoding). A writable dir OUTSIDE MEDIA_ROOT.
# HLS_DIR=./hls

# Re-index on startup + auto-rescan every N minutes (0 = off). Incremental, cheap.
SCAN_ON_START=true
SCAN_INTERVAL=5

# Port (and host) the server binds. adapter-node reads PORT/HOST.
PORT=8700
