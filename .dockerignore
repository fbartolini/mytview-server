# The Docker build context is the server directory itself (CI passes `context: ./server`), so
# sibling projects in the monorepo sit OUTSIDE the context and need no exclusions here. That's
# structural — not a list to keep in sync. It used to be the repo root, where every directory
# missed from this file got uploaded to the Docker daemon on each CI build (~550MB of it).
node_modules
.svelte-kit
build

# Runtime state must never bake into the image
*.db
*.db-shm
*.db-wal
.env
.env.*
!.env.example

# Deployment orchestration isn't part of the server image
docker-compose.yml

.DS_Store
